{
  "name": "your-local-cost-explorer",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/leejan2647-a11y/your-local-cost-explorer.git"
  },
  "homepage": "https://github.com/leejan2647-a11y/your-local-cost-explorer#readme",
  "description": "Offline AWS CUR charge analysis with a loopback web interface",
  "license": "MIT",
  "bin": {
    "your-local-cost-explorer": "bin/commitops-local.cjs"
  },
  "files": [
    "bin/*.cjs",
    "engine/**/*.py",
    "web/*.html",
    "web/*.js",
    "web/*.css",
    "requirements.txt",
    "SOURCE-INVENTORY.json",
    "README.md",
    "LICENSE",
    "MANUAL-FEATURES.md",
    "DESIGN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/commitops-local.cjs",
    "setup": "node bin/runtime.cjs",
    "postinstall": "node bin/runtime.cjs",
    "test": "node --test tests/runtime.test.cjs tests/dashboard.test.cjs tests/date-selection.test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "jsdom": "30.1.2"
  }
}
